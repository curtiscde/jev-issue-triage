{
  "name": "jev-issue-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Triage every open issue in mattpocock/skills with TypeSafe's Jev, and backtest it on the closed ones",
  "scripts": {
    "probe": "tsx pipeline/probe.ts",
    "fetch-issues": "tsx pipeline/fetch-issues.ts",
    "classify": "tsx pipeline/classify.ts",
    "blind": "tsx pipeline/blind.ts",
    "label-sample": "tsx pipeline/label-sample.ts",
    "score": "tsx pipeline/score.ts",
    "dev": "next dev -H 127.0.0.1",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ai": "^7.0.119",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "5.7.47",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
